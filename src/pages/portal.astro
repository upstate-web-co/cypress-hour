---
import BaseLayout from '../layouts/BaseLayout.astro'
import { EPISODES } from '../lib/catalog'

const recentTranscripts = EPISODES.slice(0, 5)
---

<BaseLayout
  title="Member portal — Cypress Hour"
  description="Transcript search, members-only Slack, your clip library, your subscription."
>
  <section class="px-4 md:px-6 pt-16 pb-8">
    <div class="reading-column-wide">
      <p class="eyebrow mb-6">/ Member portal</p>
      <h1 class="text-3xl md:text-5xl font-display font-black text-purple leading-[0.95] mb-4">
        Welcome back.
      </h1>
      <p class="font-serif italic text-lg text-purple-deep leading-snug">
        Member since Aug 2024 · Patron tier · Annual renewal Aug 2027 · 187 transcripts read
      </p>
    </div>
  </section>

  {/* Transcript search */}
  <section class="px-4 md:px-6 py-8 section-rule">
    <div class="reading-column-wide">
      <p class="eyebrow mb-4">/ Transcript search</p>
      <form class="flex gap-3 mb-3">
        <input type="search" placeholder="Search 207 transcripts" class="input-purple flex-1" />
        <button type="submit" class="btn-purple">Search &rarr;</button>
      </form>
      <p class="font-mono text-xs text-stone uppercase tracking-wider">Try: "the Monday after" · "tenure case" · "second album"</p>
    </div>
  </section>

  {/* Recent transcripts */}
  <section class="px-4 md:px-6 py-8 section-rule">
    <div class="reading-column-wide">
      <p class="eyebrow mb-4">/ Recent transcripts</p>
      <div class="space-y-3">
        {recentTranscripts.map((ep) => (
          <a href={`/episodes/${ep.slug}`} class="block episode-card">
            <div class="flex flex-wrap gap-2 mb-2">
              <span class="tag-meta">Ep. {ep.number}</span>
              <span class="tag-meta">{ep.durationMin} min</span>
              <span class="tag-meta">{ep.publishedAt}</span>
            </div>
            <h3 class="text-lg md:text-xl font-display font-black text-purple leading-tight">
              {ep.title}
            </h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Two-column: clips + slack */}
  <section class="px-4 md:px-6 py-8 section-rule">
    <div class="reading-column-wide grid gap-8 md:grid-cols-2">
      <div>
        <p class="eyebrow mb-4">/ Your clip library</p>
        <div class="episode-card">
          <p class="font-display text-3xl text-coral leading-none mb-2">14</p>
          <p class="font-mono text-xs uppercase tracking-wider text-stone mb-4">90s clips you've generated</p>
          <a href="/portal/clips" class="font-mono text-xs text-purple hover:text-coral uppercase tracking-wider">Open library &rarr;</a>
        </div>
      </div>
      <div>
        <p class="eyebrow mb-4">/ Slack mirror</p>
        <div class="episode-card">
          <p class="font-display text-3xl text-coral leading-none mb-2">3</p>
          <p class="font-mono text-xs uppercase tracking-wider text-stone mb-4">unread comments on transcripts</p>
          <a href="/portal/slack" class="font-mono text-xs text-purple hover:text-coral uppercase tracking-wider">Open Slack &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {/* Subscription */}
  <section class="purple-strip px-4 md:px-6 py-12">
    <div class="reading-column-wide">
      <p class="eyebrow mb-4" style="color:var(--color-coral)">/ Subscription</p>
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-4">
        <div>
          <p class="font-display text-3xl mb-2">Patron · $400 / year</p>
          <p class="font-mono text-xs uppercase tracking-wider opacity-80">Renews Aug 14, 2027 · Card on file ending 4242</p>
        </div>
        <a href="/portal/billing" class="btn-coral">Manage billing &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
