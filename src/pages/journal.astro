---
import BaseLayout from '../layouts/BaseLayout.astro'
import { JOURNAL_POSTS } from '../lib/catalog'

const byCategory = JOURNAL_POSTS.reduce<Record<string, typeof JOURNAL_POSTS>>((acc, p) => {
  acc[p.category] = acc[p.category] || []
  acc[p.category].push(p)
  return acc
}, {})

const labels: Record<string, string> = {
  'on-the-show': 'On the show',
  'on-listening': 'On listening',
  'on-quitting': 'On quitting',
  'on-the-craft': 'On the craft',
}
---

<BaseLayout
  title="Journal — Cypress Hour"
  description="Long-form essays from the host. Voice notes from four years of asking the same questions."
>
  <section class="px-4 md:px-6 pt-16 pb-12 immersive-reveal">
    <div class="reading-column">
      <p class="eyebrow mb-6">/ Journal</p>
      <h1 class="text-4xl md:text-6xl font-display font-black text-purple leading-[0.95] mb-6">
        Notes from four years of asking the same questions.
      </h1>
      <p class="font-serif italic text-xl text-purple-deep leading-snug">
        Long essays. No newsletter signup-bait. No "5 things I learned." Read the rant, or do not.
      </p>
    </div>
  </section>

  {Object.entries(byCategory).map(([category, posts]) => (
    <section class="px-4 md:px-6 py-12 section-rule">
      <div class="reading-column">
        <p class="eyebrow mb-6">/ {labels[category] || category}</p>
        <div class="space-y-8">
          {posts.map((post) => (
            <a href={`/journal/${post.slug}`} class="block">
              <p class="font-mono text-xs text-stone uppercase tracking-wider mb-2">
                {post.publishedAt} · {post.readMinutes} min read
              </p>
              <h3 class="text-2xl md:text-3xl font-display font-black text-purple hover:text-coral transition-colors mb-3 leading-tight">
                {post.title}
              </h3>
              <p class="font-body text-base text-ink leading-relaxed">
                {post.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
